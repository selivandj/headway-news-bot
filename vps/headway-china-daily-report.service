[Unit]
Description=Headway China parser evening Telegram report
After=network-online.target headway-news-bot.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/headway-news-bot
ExecStart=/opt/headway-news-bot/.venv/bin/python /opt/headway-news-bot/monitor.py --china-daily-report --send-review
Environment=PYTHONUNBUFFERED=1
